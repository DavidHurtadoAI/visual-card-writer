{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["DOM", "DOM.Iterable", "ES2018"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2018",
    "useDefineForClassFields": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["main.ts", "src/**/*.ts", "tests/**/*.ts"]
}
